# 运行环境(约 590 MB, 不进版本库; 丢了从旧安装版或上游 requirements.txt 重建)
/python/

# 运行时产物
/logs/
/cache/
/screenshots/
__pycache__/
*.pyc
configs/custom_teams/*/cache/
configs/custom_teams/.*/
configs/custom_teams/*.backup/

# 界面状态和本机信息, 每次运行都会变
/configs/main_window.json
/configs/log_window.json
/configs/tasks_page.json
/configs/ui_config.json
/configs/devices.json
/configs/_ok.json
/configs/Notification.json

# 第三方整理的全角色帧表(来源不明, 只本机做轴参考, 不公开)
/configs/鸣潮动作数据汇总.xlsx

# 本机的队伍存档和手动备份 (TeamVariants 存档、改轴前的备份), 不进版本库
/configs/custom_team_variants/
/team_backup/

# 混淆构建产物（CI 里用 git add -f 推到 obfuscated 分支，主仓库不跟踪）
/build/
/dist/
/dist-test/
