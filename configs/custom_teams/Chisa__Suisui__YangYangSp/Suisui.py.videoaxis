import time

from src.Labels import Labels
from src.char.BaseChar import BaseChar, Elements


class Suisui(BaseChar):
    """穗穗 —— 队伍位置 1, 秧千穗 25 秒轮椅轴的起手与闭环点。

    轴来自猫眼石攻略组的「秧千穗 25s 轮椅轴」教学视频, 逐帧核对过。视频里的游戏内
    倒计时是唯一可信的时间基准 —— 视频本身有慢放和重录, 视频秒不等于游戏秒, 下面
    标的 game_t 全部是倒计时换算出来的游戏内时间。

      启动轴 (空手开场, 图记 a123 E aa a1234 Q R):
        点 3 下普攻打满第一格回路 -> 等 E 图标高亮 -> E「醒春潮」把她顶上天
        -> 一直点普攻 (空中普攻 -> 下落攻击 -> 地面连段, 把回路打满)
        -> Q 声骸 -> R 山河水境 -> 协奏满, 延奏切千咲
        实测 game_t: E 在 2.35s, Q 在 7.99s, 交接在 8.66s

      循环轴 (变奏入场, 图记 变 a F a1234 Q R):
        变奏入场自带上天 -> 打一个下落攻击 -> 落地立刻 F 处决断后摇
        -> 地面连段打满回路 -> Q -> R -> 切千咲
        实测 game_t: 入场 28.15s, 下落攻击 28.92s, 落地/处决 30.03s
        循环轴【没有 E】—— 变奏技能已经替代了醒春潮那一步, 这也是它比启动轴快的原因

    两条轴汇合在"地面连段 -> Q -> R -> 切人"这后半段 (finish())。

    和框架默认轮换的两处硬性差别, 别改回去:
      1. 切人走 direct_switch() 按数字键死顺序切千咲, 不走 switch_next_char() ——
         后者按 get_switch_priority() 现场挑人, 顺序会漂;
      2. R 传 click_f=False。她的大招动画长, 框架默认每 0.1 秒发一次 F, 等于替全队
         按掉几十次处决 —— 循环轴那一下 F 处决就是被这些自动 F 提前吃光的。
         全队的 F 只归循环轴里那一个点管。
    """

    # ================================================================ 固定顺序切人 (公共段)
    # 这一段在 Suisui.py / Chisa.py / YangYangSp.py 三个文件里逐字一样, 改一处记得同步改三处。
    # 下面各自的常量写在这一段【之后】, 所以子类想覆盖哪个直接在下面重写就行。
    #
    # 为什么不用框架的 switch_next_char():
    #   1. 它按 get_switch_priority() 现场挑人, 顺序会漂 —— 这套轴要求死顺序;
    #   2. 它内部有三处补普攻 ("performing too fast add a normal attack"、维持锁定、
    #      切换未检测到时补点击), 打完最后一下想立刻走人时那几下 A 会把节奏拖乱。
    # 代价是框架的交接记账要自己补, 全在 handoff_to() 里。

    SWITCH_TIMEOUT: float = 2.0        # 单程切人的最长尝试时间 (秒)
    SWITCH_KEY_INTERVAL: float = 0.12  # 连按数字键的间隔 (秒)
    # 切到之后等角色站稳的时间 (秒)。很敏感 —— 实测 0.50 / 0.52 会让下一个角色的起手被吞,
    # 0.55 才稳, 别再往下压
    SWITCH_SETTLE: float = 0.55
    SETTLE_ATTACK_INTERVAL: float = 0.42
    HANDOFF_CON_WAIT: float = 0.8      # 交接时等协奏读数稳定的上限 (秒)
    HANDOFF_CON_POLL: float = 0.1
    HOLD_POLL: float = 0.1             # 长按期间轮询条件的间隔 (秒)
    # 切走前按 F 处决 —— 框架 switch_next_char() 里有 current_char.f_break(True), 直接
    # 按数字键切人会绕开它。这套轴里默认【关掉】: handoff_to() 是在 switch_to_index()
    # 之后调的, 那时候下一个角色已经站上场了, 这一下 F 会被他吃掉, 而且发生在他的 R
    # 之前 (千咲"还没按 R 就开处决"就是这么来的)。处决统一由千咲在 R 之后接
    F_BREAK_ON_HANDOFF: bool = False

    # 别人用 handoff_to() 直接切给我时打的标记, 写成类属性省掉 __init__。
    # 不能只靠 has_intro —— reset_state() 每次重读队伍都会把它清成 False, 而战斗判定
    # 一抖动就会重进战斗、重读队伍, 于是角色以为自己空手入场, 跑去走开场那套流程
    intro_pending = False

    def note_intro_handoff(self):
        """被别人用直接切人的方式交接进场时调用 —— 记下"我是带着变奏上来的"。"""
        self.intro_pending = True

    def take_intro(self):
        """本次入场是否带着变奏。读完就清, 避免下一轮误判。"""
        intro = self.has_intro or self.intro_pending
        self.intro_pending = False
        return intro

    def reset_fixed_rotation(self):
        """战斗结束时调 —— 在各自的 on_combat_end() 里。"""
        self.intro_pending = False

    def direct_switch(self, slot=None, assume_intro=False):
        """按数字键直接切到指定队伍位置 (1-based), 并自己补上框架的交接记账。

        Args:
            slot: 不传就用 NEXT_SLOT。
            assume_intro: True 时不读协奏, 直接认定是满的。刚放完大招要用这个 ——
                能量环读数滞后会把 has_intro 误判成 False, 下一个角色就拿不到变奏增益。
        """
        slot = self.NEXT_SLOT if slot is None else slot
        if slot is None:
            return False
        target = self.char_at_slot(slot)
        if target is None or target is self:
            return False

        has_intro = True if assume_intro else self.wait_con_full()
        if not self.switch_to_index(target.index):
            self.logger.warning(f'direct switch to slot {slot} failed')
            return False
        self.logger.info(f'direct switched to slot {slot} ({target.char_name}, intro={has_intro})')
        self.handoff_to(target, has_intro)
        return True

    def switch_to_index(self, index):
        """按数字键切到指定队伍位置, 直到 in_team 确认切过去了。

        点击落在谁身上就由谁打出来, 所以等待期间也保持点普攻, 两边连段都不断档。
        """
        start = time.time()
        while time.time() - start < self.SWITCH_TIMEOUT:
            in_team, current_index, _ = self.task.in_team()
            if in_team and current_index == index:
                self.settle_with_attack(self.SWITCH_SETTLE)
                return True
            self.task.send_key(index + 1)
            self.click()
            self.sleep(self.SWITCH_KEY_INTERVAL, check_combat=False)
        return False

    def settle_with_attack(self, duration):
        """等 duration 秒, 期间保持点普攻, 不干等。"""
        end = time.time() + duration
        while time.time() < end:
            self.click()
            self.sleep(min(self.SETTLE_ATTACK_INTERVAL, max(0.0, end - time.time())),
                       check_combat=False)

    def handoff_to(self, target, has_intro):
        """把场上角色交接给 target —— 复刻 switch_next_char() 内部那套记账。

        直接按数字键切人绕开了框架的交接逻辑, 必须自己补上, 否则:
          - 没人的 is_current_char 是 True → get_current_char() 返回 None → 下一帧崩溃;
          - has_intro / last_outro_time 不更新, 下一个角色拿不到变奏。
        """
        if self.F_BREAK_ON_HANDOFF:
            self.f_break(check_f_on_switch=True)
        self.task.in_liberation = False
        self.switch_out(con_full=has_intro)
        target.is_current_char = True
        target.has_intro = has_intro
        if has_intro and hasattr(target, 'note_intro_handoff'):
            # has_intro 是易失的, 再给对方补一个它自己保管的持久标记
            target.note_intro_handoff()
        target.last_switch_in_time = time.time()
        if has_intro:
            now = time.time()
            self.task.add_freeze_duration(now, target.intro_motion_freeze_duration, -100)
            self.last_outro_time = now

    def wait_con_full(self):
        """短暂轮询协奏是否满 —— 用来决定交接时给不给对方变奏。

        不能只读一次: 打完最后一下那一刻协奏其实已经满了, 但能量环读数滞后。
        必须在【按切人键之前】读: 切走之后能量环显示的已经是新角色的了。
        """
        start = time.time()
        while time.time() - start < self.HANDOFF_CON_WAIT:
            if self.is_con_full():
                return True
            self.sleep(self.HANDOFF_CON_POLL, check_combat=False)
        self.logger.info(f'con not full before switch (con={self.get_current_con()}), '
                         f'next char gets no intro')
        return False

    def char_at_slot(self, slot):
        """按队伍位置 (1-based) 取角色, 越界返回 None。"""
        index = slot - 1
        for char in self.task.chars:
            if char is not None and char.index == index:
                return char
        return None

    def attack_chain(self, count, interval, last_interval=None):
        """点按普攻打一轮连段。

        Args:
            last_interval: 最后一段之后的间隔。后面紧接切人时传更小的值 —— 按下切人键之后
                还要等游戏识别切换完成, 那段时间最后一下的动作照样在演, 两者是重叠的。
        """
        for i in range(count):
            self.click()
            if i == count - 1 and last_interval is not None:
                self.sleep(last_interval)
            else:
                self.sleep(interval)

    def hold_until(self, cond, timeout, name):
        """轮询某个条件, 期间不动手 —— 攻击键的按下/松开由调用方管。"""
        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < timeout:
            if cond():
                self.logger.info(f'{name} ready after '
                                 f'{self.time_elapsed_accounting_for_freeze(start):.1f}s')
                return True
            self.sleep(self.HOLD_POLL)
        self.logger.info(f'timed out waiting for {name} ({timeout:.1f}s)')
        return False


    # ---------------------------------------------- "没打到就不许切人" 的硬 gate
    # 这套轴是靠变奏/延奏一棒接一棒串起来的: 任何一棒少做一步, 代价都直接传给下一棒。
    # 实测 21:23 那一圈就是完整的传染链:
    #   穗穗 forte3 没读到 -> 硬走 Q/R -> "liberation not ready, leaving without field"
    #   -> 领域没放, 千咲上场 -> "chisa: liberation not ready" -> 整圈裸打。
    # 所以关键步骤不再"到点就走", 改成留场重试到真打出来为止。
    #
    # 【没有超时是有意的】: 给上限就等于"打不出来也走", 那这个 gate 等于没有。
    # 唯一的出口是 check_combat() —— 脱战/任务被停时它抛异常, 整条轴一起退出。
    # 怪都没了的话, "这一步没打到"本来也就不是问题了。
    GATE_POLL: float = 0.12       # gate 轮询间隔 (秒)
    GATE_LOG_EVERY: float = 3.0   # 卡住时每隔这么久打一条日志, 好在日志里一眼看出卡在哪

    def require(self, name, cond, action=None):
        """留场直到 cond() 成立 —— 这一步没做到就不许往下走。

        Args:
            name: 打日志用的步骤名, 卡住时就是靠它定位。
            cond: 判据, 返回真就放行。
            action: 每轮做的事, 一般传 self.click。不传就是干等 (长按期间要用这个,
                手上已经按着了, 再 click 会打断长按)。

        Returns:
            True。走不出去只有一种可能: check_combat() 抛异常。
        """
        start = time.time()
        last_log = 0.0
        while True:
            if cond():
                waited = self.time_elapsed_accounting_for_freeze(start)
                if waited > 0.3:
                    self.logger.info(f'gate [{name}] ok after {waited:.1f}s')
                return True
            self.check_combat()
            if action is not None:
                action()
            elapsed = self.time_elapsed_accounting_for_freeze(start)
            if elapsed - last_log >= self.GATE_LOG_EVERY:
                last_log = elapsed
                self.logger.warning(f'gate [{name}] not satisfied after {elapsed:.1f}s, '
                                    f'staying on field')
            self.sleep(self.GATE_POLL)

    def require_cast(self, name, send, landed, pre=None):
        """反复按某个键直到它真的放出去了。

        跟 require() 的区别: 这里每轮都【重新发键】。被打断时按键会被游戏吃掉,
        补发是唯一的解法。
        Args:
            send: 发键的函数。
            landed: 判据 —— "已经放出去了"返回真。
            pre: 发键之前必须先成立的条件 (比如"图标亮了"), 不成立就先不发, 省得
                在冷却里空按。不传就是每轮都发。
        """
        start = time.time()
        last_log = 0.0
        while True:
            if landed():
                waited = self.time_elapsed_accounting_for_freeze(start)
                self.logger.info(f'gate [{name}] cast confirmed after {waited:.1f}s')
                return True
            self.check_combat()
            if pre is None or pre():
                send()
            elapsed = self.time_elapsed_accounting_for_freeze(start)
            if elapsed - last_log >= self.GATE_LOG_EVERY:
                last_log = elapsed
                self.logger.warning(f'gate [{name}] not cast after {elapsed:.1f}s, retrying')
            self.sleep(self.GATE_POLL)

    # ============================================================ 公共段结束

    # ================================================================ 本队的固定轴

    NEXT_SLOT = 2  # 打完切千咲

    # ---- 启动轴 ----
    # 开场先点几下普攻。图上写 a123 = 普攻前三段, 打满第一格回路
    OPEN_CHAIN: int = 3
    OPEN_CHAIN_INTERVAL: float = 0.35
    # 等 E 高亮的上限 (秒)。点完 3 下约 1.0s, 加上这段正好落在实测的 2.35s 附近。
    # 超时也照按 —— 识别失灵不该把整条轴卡死
    OPEN_E_MAX_WAIT: float = 2.5
    E_TO_ATTACK: float = 0.25   # 按完 E 到起手普攻的间隔 (秒)
    # E 之后一直点普攻到丢声骸的时间 (秒)。实测 E(2.35s) -> Q(7.99s) = 5.64s,
    # 覆盖"空中普攻 -> 下落攻击 -> 地面连段"整段。三格回路提前满就提前走, 这是上限
    OPEN_ATTACK_TIME: float = 5.6

    # ---- 循环轴 ----
    # 变奏入场到打下落攻击的间隔 (秒), 实测 0.77。基准是【切人完成那一刻】
    # (switch_in_anchor), 不是 do_perform 被调用那一刻 —— 中间隔着框架的交接记账,
    # 这段延迟是变长的
    INTRO_TO_PLUNGE: float = 0.75
    # 下落攻击到落地的间隔 (秒), 实测 1.11。到点才按 F, 早了没有处决提示, 白按
    PLUNGE_TO_LAND: float = 1.10
    # 处决之后的缓冲 (秒)。击破动画带全局时停, 紧接着的普攻会被吞掉一部分。
    # 没处决成的话这段就是白等 0.25 秒, 代价可以接受
    POST_BREAK_WAIT: float = 0.25
    # 处决之后点普攻到丢声骸的时间 (秒)。启动轴的"下落攻击 -> Q"实测 4.47s,
    # 循环轴少了空中那一段、又用处决断掉了落地后摇, 所以给 3.2。同样是上限
    LOOP_ATTACK_TIME: float = 3.2

    # ---- 后半段公用 ----
    ATTACK_INTERVAL: float = 0.22
    ECHO_TO_LIB: float = 0.30    # Q 之后到开 R 的间隔 (秒), 实测 ~0.3
    ECHO_TIMEOUT: float = 1.0    # 轮询 Q 图标可用的上限 (秒)
    ECHO_FORCE: bool = True      # 到点还读不到图标就盲按一次 —— 真在 CD 按了也没副作用
    ECHO_KEY_DOWN: float = 0.05  # 按 Q 的按下时长 (秒), 框架默认才 0.01
    LIB_WAIT: float = 0.30       # 传给 click_liberation 的 wait_if_cd_ready (秒)
    # 打到时间上限还没读到三格回路满时, 最多再宽限多久 (秒)。
    # 回路没满就开 R 是纯亏, 但也不能无限等 —— 等不到照放
    FORTE3_EXTRA_WAIT: float = 2.0

    # ---- 三格回路 (芳菲信 600) 判定 ----
    FORTE3_THRESHOLD: float = 0.75  # 0.6 太松会误判
    FORTE3_CONFIRM: int = 2         # 连续命中这么多次才认, 单帧误判不算
    FORTE2_THRESHOLD: float = 0.75

    # ---- E 图标高亮判定 (跟千咲/秧秧同一套) ----
    # 框架的 resonance_available() 主动传 check_color=False, 只查 CD 不查高亮,
    # 所以"E 亮没亮"得自己读像素占比
    E_LIT_BOX: str = 'box_resonance'
    E_LIT_COLOR = {'r': (200, 255), 'g': (200, 255), 'b': (200, 255)}
    E_LIT_THRESHOLD: float = 0.13
    E_LIT_CONFIRM: int = 2
    E_LIT_POLL: float = 0.03
    E_KEY_DOWN: float = 0.05

    # 循环轴的计时锚点最多能有多旧 (秒), 超了就用当前时刻兜底
    SWITCH_ANCHOR_MAX: float = 1.5
    # 交接前等协奏读数的上限 (秒)。刚放完 R 就要走, 协奏满不满在放 R 那一刻就定了,
    # 多等也不会变 —— 而且下面走的是 assume_intro=True, 这个值只在 R 没放出去时用得上
    HANDOFF_CON_WAIT: float = 0.3

    def __init__(self, *args, **kwargs):
        super().__init__(*args, **kwargs)
        self._forte3_hits = 0
        if self.ring_index < 0:
            # CharFactory 里穗穗没写 ring_index, 环色会被现场猜; 万一第一次判定发生在
            # 大招特效糊住能量环的时候就会锁死错值, 而离场判定完全依赖 is_con_full()
            self.ring_index = Elements.ICE

    def reset_state(self):
        super().reset_state()
        # v3.5.32 起必须在这里重申: apply_team_char_classes() 的 __dict__.update
        # 会把 ring_index 打回 CharFactory 给的 -1
        if self.ring_index < 0:
            self.ring_index = Elements.ICE
        self._forte3_hits = 0

    def on_combat_end(self, chars):
        self.reset_fixed_rotation()
        super().on_combat_end(chars)

    # ------------------------------------------------------------------ 路由

    def do_perform(self):
        intro = self.take_intro()
        if intro:
            return self.loop_axis()
        if self.looks_like_lost_intro():
            # 框架的 switch_healer() -> switch_other_char() 只改 is_current_char,
            # 既不设 has_intro 也不走 handoff_to() —— 被它切上场的角色会以为自己是
            # 空手进的, 跑去走启动轴 (表现就是站在空中点普攻等 E)
            self.logger.warning('suisui: intro bookkeeping lost, running the loop axis anyway')
            return self.loop_axis()
        return self.opening_axis()

    def looks_like_lost_intro(self):
        """没拿到变奏标记, 但看起来其实是带变奏进来的。

        两个条件都要满足才认, 宁可误判成启动轴 (慢一点) 也不能误判成循环轴
        (那会在地上按下落攻击):
          - 切人完成就在刚才 (SWITCH_ANCHOR_MAX 之内);
          - 回路槽已经有读数 —— 空手开场时它必须是空的, 一下普攻都还没点过。
        """
        gap = time.time() - self.last_switch_in_time
        if not (0 <= gap <= self.SWITCH_ANCHOR_MAX):
            return False
        return self.gauge_present()

    # ------------------------------------------------------------------ 启动轴

    def opening_axis(self):
        """a123 -> E -> 一直普攻 -> (finish: Q -> R -> 切千咲)"""
        self.logger.info('suisui opening axis: a123 -> E -> A -> Q -> R')
        # F 处决只归循环轴那一个点管, 别让框架在切人时替她按掉
        self.check_f_on_switch = False
        if self.flying():
            self.wait_down()

        self.attack_chain(self.OPEN_CHAIN, self.OPEN_CHAIN_INTERVAL)

        # 【必须打到 1】启动轴的第一个强化E (醒春潮)。视频里的提醒是
        # 「随后小技能高亮，按E释放」—— 所以先打到高亮, 再按到真放出去为止。
        # 原来是"等 2.5 秒到点盲按", 被打断那一轮就是一发空 E, 人根本没上天,
        # 后面整段空中/下落连段全没了
        self.require('醒春潮E 高亮', self.e_ready, self.click)
        self.require_cast('醒春潮E',
                          send=lambda: self.send_resonance_key(down_time=self.E_KEY_DOWN),
                          landed=lambda: self.has_cd('resonance'))
        self.sleep(self.E_TO_ATTACK)

        # 上天之后一直点普攻: 空中普攻 -> 下落攻击 -> 地面连段
        self.attack_until_forte3(self.OPEN_ATTACK_TIME)
        return self.finish()

    # ------------------------------------------------------------------ 循环轴

    def loop_axis(self):
        """下落攻击 -> F 处决 -> 地面连段 -> (finish: Q -> R -> 切千咲)"""
        self.logger.info('suisui loop axis: plunge -> F break -> A -> Q -> R')
        self.check_f_on_switch = False
        anchor = self.switch_in_anchor()

        # 变奏入场动作演完才吃得到点击, 早点的那一下会被吞掉
        self.sleep_until(anchor + self.INTRO_TO_PLUNGE)
        self.click()  # 下落攻击
        self.sleep(self.PLUNGE_TO_LAND)

        self.execute_break()  # F 处决, 断掉落地后摇
        self.attack_until_forte3(self.LOOP_ATTACK_TIME)
        return self.finish()

    def execute_break(self):
        """落地立刻按 F 处决 —— 这一下是为了断后摇, 不是为了那点伤害。

        f_break() 是找图触发的: 没有处决提示它根本不会发键, 所以无脑按没有副作用,
        也就不需要我们自己再判一次 (而且自己判也判不准 —— 外面这次找图和它内部
        那次不是同一帧)。
        """
        broke = self.f_break()
        self.logger.info(f'suisui: f break sent (prompt found={bool(broke)}), '
                         f'+{self.POST_BREAK_WAIT:.2f}s buffer')
        self.sleep(self.POST_BREAK_WAIT, check_combat=False)
        return broke

    # ------------------------------------------------------------------ 后半段

    def finish(self):
        """Q -> R -> 直接切千咲。两条轴汇合在这里。"""
        self.cast_echo()
        self.sleep(self.ECHO_TO_LIB)

        # 【必须打到 3】领域必须放出来才准走。这是全队 30 秒的核心增益, 少一次
        # 后面两棒就是裸打 —— 实测 21:23 那一圈的传染链就是从这里开始的。
        # R 图标不亮 = 协奏能量没满(check_color=True 查的就是这个), 不是冷却,
        # 所以补救办法是【接着打】而不是等
        self.require('R 能量', self.liberation_available, self.click)

        # click_f=False 是关键, 见类注释
        cast = self.click_liberation(wait_if_cd_ready=self.LIB_WAIT, click_f=False)
        if cast:
            self.logger.info('suisui: field deployed')
        else:
            # 图标亮着却没放出去 = 按键被硬直吃了, 补按到进冷却为止
            self.logger.warning('suisui: R pressed but not cast, retrying')
            self.require_cast('R 领域',
                              send=lambda: self.send_liberation_key(),
                              landed=lambda: self.has_cd('liberation'))
            cast = True

        # assume_intro=cast 是有意的: 刚放完 R 协奏基本一定满, 而能量环读数滞后会把
        # has_intro 误判成 False, 千咲于是拿不到变奏, 她那条轴的第一个动作就废了。
        # R 没放出去时不敢这么认, 老老实实回去读协奏
        if self.direct_switch(assume_intro=cast):
            return
        self.switch_next_char()

    def attack_until_forte3(self, duration):
        """【必须打到 2】点普攻直到三格回路满 —— 没满就不许开 R, 也就不许切人。

        视频里的提醒是「直到满回路以后丢声骸开大招」。
        duration 现在只用来打日志(记录"正常该多久"), 不再是退出条件 ——
        原来到点就 "going to Q/R anyway", 结果是回路没满硬开 R, 而 R 那时候
        根本没能量, 直接 "leaving without field", 整队少一个 30 秒领域。
        用点按不用长按: 长按走的是重击, 连段的段数吃不满。
        """
        start = time.time()
        self.require('三格回路满', self.forte3_available, self.click)
        elapsed = self.time_elapsed_accounting_for_freeze(start)
        if elapsed > duration + 1.0:
            self.logger.info(f'suisui: forte3 took {elapsed:.1f}s (planned {duration:.1f}s) '
                             f'— 大概率中间被打断了')
        return True

    def cast_echo(self):
        """Q 声骸 —— 不走 click_echo(), 自己轮询 + 兜底盲按。

        click_echo() 两条路都要求 echo_available() 为 True 才发键: time_out=0 只读
        一帧, time_out>0 的循环里第一句就是 `if not echo_available(): break`。
        图标一读不到, Q 就一次都不会按。
        """
        start = time.time()
        while self.time_elapsed_accounting_for_freeze(start) < self.ECHO_TIMEOUT:
            if self.echo_available():
                self.send_echo_key(down_time=self.ECHO_KEY_DOWN)
                self.record_echo_use()
                self.logger.info(f'suisui: echo cast after '
                                 f'{self.time_elapsed_accounting_for_freeze(start):.2f}s')
                return True
            self.sleep(self.HOLD_POLL)
        self.logger.info(f'suisui: echo icon not detected in {self.ECHO_TIMEOUT:.1f}s '
                         f'(cd={self.has_cd("echo")}), force={self.ECHO_FORCE}')
        if self.ECHO_FORCE:
            self.send_echo_key(down_time=self.ECHO_KEY_DOWN)
            self.record_echo_use()
            return True
        return False

    # ------------------------------------------------------------------ 判定

    def wait_e_lit(self, max_wait):
        """等 E 图标高亮 (醒春潮可放)。期间保持点普攻, 不干等。

        三个信号取先到的那个: 像素占比过阈值 / 框架的 e_forte 通用标记 /
        她自己那张 suisui_e1 图标。取"或"只可能更早不可能更晚。
        返回等了多久 (秒); 超时也返回, 由调用方照样按。
        """
        start = time.time()
        hits = 0
        last_click = -1.0
        while True:
            elapsed = self.time_elapsed_accounting_for_freeze(start)
            if elapsed >= max_wait:
                self.logger.info(f'suisui: e icon not lit in {max_wait:.1f}s, pressing anyway')
                return elapsed
            if elapsed - last_click >= self.ATTACK_INTERVAL:
                last_click = elapsed
                self.click()
            white = self.e_icon_white()
            hits = hits + 1 if white >= self.E_LIT_THRESHOLD else 0
            if hits >= self.E_LIT_CONFIRM:
                return elapsed
            if self.e_ready():
                return elapsed
            self.sleep(self.E_LIT_POLL)

    def e_icon_white(self):
        """E 技能图标框里的白像素占比。读不到时返回 -1, 不让它把轴卡住。"""
        try:
            box = self.task.get_box_by_name(self.E_LIT_BOX)
            return self.task.calculate_color_percentage(self.E_LIT_COLOR, box)
        except Exception as e:
            self.logger.info(f'suisui: e icon probe failed ({e})')
            return -1

    def e_ready(self):
        """框架侧的两个"E 充满"信号, 任一命中就算亮了。"""
        return bool(self.is_e_forte_full()) or bool(self.task.find_one(Labels.suisui_e1))

    def forte3_available(self):
        """三格回路 (芳菲信 600) 满没满。连读 FORTE3_CONFIRM 帧都命中才认, 挡单帧误判。

        【这几帧是连着读完的, 中间不点普攻】—— 原来是靠外层循环去凑第二次命中,
        计数器每轮才加一, 于是第一帧命中后必然还要再打一下 A 才够数。
        实机看到的"回路满了还要多 A 一下才 QR 切人"就是这么来的。
        """
        for i in range(self.FORTE3_CONFIRM):
            if not self.task.find_one(Labels.suisui_forte3, threshold=self.FORTE3_THRESHOLD):
                return False
            if i + 1 < self.FORTE3_CONFIRM:
                self.task.next_frame()  # 换一帧再读, 否则两次读的是同一张图
        return True

    def gauge_present(self):
        """回路槽有没有读数。两张图取或: 400 和 600 在图上是两个状态,
        只查 forte2 会在满 600 的那几秒读成"没有"。"""
        return bool(self.task.find_one(Labels.suisui_forte2, threshold=self.FORTE2_THRESHOLD)) \
            or bool(self.task.find_one(Labels.suisui_forte3, threshold=self.FORTE3_THRESHOLD))

    # ------------------------------------------------------------------ 小工具

    def switch_in_anchor(self):
        """循环轴的计时基准: 头像认出"切人完成"的那一刻 (handoff_to 写的
        last_switch_in_time), 而不是 do_perform 被调用那一刻 —— 两者之间隔着框架的
        交接记账、上个角色的返回、任务循环再调到穗穗, 这段延迟是变长的。
        """
        now = time.time()
        anchored = self.last_switch_in_time
        gap = now - anchored if anchored > 0 else -1
        if 0 <= gap <= self.SWITCH_ANCHOR_MAX:
            self.logger.info(f'suisui: anchored on switch-in, {gap:.2f}s ago')
            return anchored
        self.logger.info(f'suisui: switch-in timestamp unusable (gap {gap:.2f}s), using now')
        return now

    def sleep_until(self, deadline):
        """睡到某个绝对时刻, 已经过了就立刻返回。"""
        remaining = deadline - time.time()
        if remaining > 0:
            self.sleep(remaining, check_combat=False)
