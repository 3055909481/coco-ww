import ctypes
import threading
import time

from src.Labels import Labels
from src.char.BaseChar import SwitchPriority
from src.char.YangYangSp import YangYangSp as NativeYangYangSp

# ==================== 物理 F 键监视 ====================
# 跟 Changli__Jinhsi__Verina/Changli.py 里那份逐字相同, 说明见那边。
# 几个队伍文件都能启动这个线程, 但每个 task 只启一次(_f_watch_started) —— 所以宏在跑时
# 两个标志都要置上, 不管是哪个文件先启的线程都认得出"这是手动处决, 不是重开副本"。
F_VK = 0x46              # 'F'
F_POLL_INTERVAL = 0.05   # 一次按键按住的时间远大于这个, 不会漏采
F_LOG_DEBOUNCE = 1.0     # 按住不放时别刷日志
# 界面上那张设置卡片, 在 ok_tasks/FStartCombatTask.py。放 ok_tasks/ 是因为选项必须由
# 代码声明(json 里多出来的键会被 verify_config 丢掉), 而 config.py/src 每次更新都会被
# 盖回官方版 —— 上一版的开关和时间就是这么没的。ok_tasks/ 不在仓库里, 更新不碰。
F_TASK_NAME = 'FStartCombatTask'


def f_settings(task):
    """读界面上的(开关, F 之后等待秒数)。

    【没装那张卡片就返回默认值(开, 0 秒)】—— 把队伍导给别人时对方没有 ok_tasks/
    里的那个任务, 功能照常, 只是他那边没有界面可调。
    """
    executor = getattr(task, 'executor', None)
    for group in ('trigger_tasks', 'onetime_tasks'):
        for other in getattr(executor, group, None) or ():
            if type(other).__name__ == F_TASK_NAME:
                try:
                    return bool(other.enabled), float(getattr(other, 'f_start_delay', 0) or 0)
                except Exception:
                    return True, 0.0
    return True, 0.0


# ==================== 自动战斗开关监视 ====================
# 【玩家手动开关自动战斗, 必须从启动轴重跑】(2026-09-22 用户明确要求:
# "以后做的轴, 都要确保不管什么时候开关自动战斗, 都要从一开始启动")。
#
# 为什么不会自己重跑: 手动停任务是【任务停止把战斗循环打断】, 异常一路往上抛,
# `AutoCombatTask` 的 combat_end() 整个跳过 -> `on_combat_end()` 不执行 ->
# 角色实例上的标记全部留着, 其中就有 `opener_armed=False`。重开时【队伍识别没变化的话
# load_chars() 也不会跑】(角色对象被粘性复用), 于是 reset_state() 里那句
# `opener_armed = True` 根本轮不到执行 —— 直接跳到循环轴。
# 实机日志的形状: 一连串 `opener not pending (already armed-down (ran once this combat))`。
#
# 【为什么用线程而不是在 do_perform 里判】: do_perform 只在任务【已经启用】时才会被调到,
# 站在里面永远看不到"刚才关过"。只有独立线程能观察到 enabled 的 True->False->True。
# 判据跟物理 F 键那条路完全一致: 记一个时间戳, 调用方比 `> last_opener` 就放行。
ENABLE_POLL_INTERVAL = 0.2


def start_enable_watch(task, logger=None):
    """盯 task.enabled 的 False->True 跳变, 把时刻记到 task._ww_task_restarted_at。

    daemon 线程, 跟着进程退出。每个 task 只启一次。
    """
    if getattr(task, '_ww_enable_watch_started', False):
        return
    task._ww_enable_watch_started = True
    if not hasattr(task, '_ww_task_restarted_at'):
        # -1 = "从没重启过", 跟 last_opener 的"没跑过"对齐
        task._ww_task_restarted_at = -1

    def watch():
        was_on = None
        while True:
            try:
                now_on = bool(getattr(task, 'enabled', False))
                if was_on is False and now_on:
                    task._ww_task_restarted_at = time.time()
                    if logger:
                        logger.info('auto combat re-enabled -> opener re-armed')
                was_on = now_on
                time.sleep(ENABLE_POLL_INTERVAL)
            except Exception:
                return          # 进程收尾时安静退出

    threading.Thread(target=watch, name='ok_ww_enable_watch', daemon=True).start()


def start_f_watch(task, logger=None):
    """把【物理】F 键按下的墙钟时间记到 task._f_last_press。每个 task 只启一次。

    线程是 daemon, 跟着进程退出, 不用管回收。
    """
    if getattr(task, '_f_watch_started', False):
        return
    task._f_watch_started = True
    if not hasattr(task, '_f_last_press'):
        # 【初值取 -1 而不是 0】: 读取方是 `if f_press > self.last_opener`, 而
        # last_opener 的"没跑过"也是 -1。给 0 的话开局第一次判定就恒成立(0 > -1),
        # 会连 use_liberation 那道检查一起跳过 —— 两边都用 -1 表示"从没发生过"才对得上
        task._f_last_press = -1

    def watch():
        try:
            user32 = ctypes.windll.user32
            user32.GetAsyncKeyState.restype = ctypes.c_short
        except Exception as e:
            task._f_watch_started = False
            if logger:
                logger.error(f'f watch: GetAsyncKeyState unavailable ({e}), '
                             f'the "press F to re-arm the opener" shortcut stays off')
            return
        last_log = 0
        was_down = False
        while True:
            try:
                down = bool(user32.GetAsyncKeyState(F_VK) & 0x8000)
                if down and not was_down and f_settings(task)[0]:
                    # 【上升沿才算一次按下】。原来是"只要按着就每轮记一次",
                    # 对 _f_last_press(取最新时刻)无所谓, 但下面 _f_pressed_at 是
                    # 给框架消费的, 按住不放时反复刷新会让它永远"刚刚才按"
                    now = time.time()
                    # 【宏正在跑 = 正在战斗, 这下 F 是玩家手动处决, 不是重开副本】(2026-09-11 日志:
                    # 06:17:40 手动处决的那一下 F 打出了 "opener re-armed" —— 下一次进长离就会从头
                    # 跑启动轴)。只在宏空闲时才把 F 当成"重开了一局"
                    if (getattr(task, '_three_fire_macro_busy', False)
                            or getattr(task, '_ww_macro_busy', False)):
                        if logger and now - last_log >= F_LOG_DEBOUNCE:
                            last_log = now
                            logger.info('physical F pressed while the macro is running '
                                        '(manual execution) - opener NOT re-armed')
                        was_down = down
                        time.sleep(F_POLL_INTERVAL)
                        continue
                    task._f_last_press = now
                    # 【这里是本线程和框架的唯一交接点】(2026-08-19):
                    # 框架 CombatCheck.note_f_key() 原本自己调 GetAsyncKeyState,
                    # 判据是【低位】—— 那一位的语义是"距上次调用之间被按过",
                    # 【读一次就清, 而且整个进程共享】。本线程 20 毫秒轮询一次,
                    # 每次调用都会把低位清掉, 框架那边就永远读到 0 ——
                    # 结果是 watcher 一直在打日志, 而"按 F 直接进战斗"从来不触发。
                    # 现在改成【一个读者】: 本线程读键, 顺手把框架要的时间戳也写了,
                    # 框架不再自己读(见 CombatCheck.note_f_key 里的 watcher 分支)。
                    task._f_pressed_at = now
                    if logger and now - last_log >= F_LOG_DEBOUNCE:
                        last_log = now
                        logger.info('physical F pressed, opener re-armed')
                was_down = down
                time.sleep(F_POLL_INTERVAL)
            except Exception:
                return          # 进程收尾时 ctypes/解释器可能已经拆掉了, 安静退出

    threading.Thread(target=watch, name='ok_ww_f_watch', daemon=True).start()




class YangYangSp(NativeYangYangSp):
    """秧秧·玄翎。秧千穗(千咲/穗穗/秧秧·玄翎)里她兼任【整条轴的持宏者】。

    ================= 轴的出处 =================
    B 站 Sy1is 的秧千穗实录 + 两张宏面板截图, 本地 E:/轴视频/9月22日.mp4
    (1920x1080 / 30fps / 206.9s, 【混了 1~3 倍慢放和冻结帧, 不能当墙钟】——
    对表要读画面里的游戏倒计时)。作者队伍编成 1 穗穗 / 2 千咲 / 3 秧秧·玄翎,
    跟本目录原来的 NEXT_SLOT 一致。实录里一局 120 秒跑满 4 轮循环。

    ================= 一大轮的形状 =================
        启动宏(23.3s) -> 手动段(秧秧 2羽1苍) -> 循环宏(21.5s) -> 手动段 -> ...
    【两条宏都在同一个位置结束】: 千咲一下 A 之后变奏切秧秧入场 —— 所以手动段只写一份,
    启动宏跑完和每条循环宏跑完接的是同一段。启动宏第 30 格(穗穗 Q)往后到倒数第二格,
    跟循环宏第 26 格往后【逐格相同】, 只差收尾那一下 A 的间隔(300 / 400ms)。

    ================= 手动段: 为什么叫"2羽1苍" =================
    秧秧·玄翎有【苍剑式】和【羽剑式】两种形态, 按 E 切换; 重击要【苍翎】满 2 点才放得出来,
    而且两种形态的重击是两个不同技能、各自带一个 25 秒 CD 的暴伤 buff:
      · 重击·苍剑式 -> 巨大气旋, 获得【绝息】, 本次重击暴伤 +160%
      · 重击·羽剑式 -> 命中后自动接空中攻击·释羽风落, 获得【流岚】15 秒,
        并进入【聆风祀声】12 秒 —— 这期间羽剑式普攻替换成普攻·湮象风华(3 段, 算重击伤害)
    苍翎上限 2, 变奏入场 +1 / 共鸣解放 +1 / 剑式流转(流响耗尽时按 E)+1, 重击消耗全部。
    所以一轮的苍翎账是:
        变奏入场+1 -> E 流转+1(满2) -> 重击·苍剑式(1苍, 清空)
        -> R 共鸣解放+1 -> E 流转+1(满2) -> 重击·羽剑式 -> 释羽风落(1羽, 清空, 进聆风祀声)
        -> 聆风祀声里接普攻·湮象风华(第2羽, 不吃苍翎; 第2、3段在低空施放, 实录里就是贴地连挥)
    【第2羽不是可打可不打的收尾】: 重击·羽剑式给的【流岚】(160% 暴伤)要到
    "普攻·湮象风华第3段结束"才移除 —— 少打这几下等于把 buff 剩下的部分扔了。
    字幕原话:
        "启动宏结束, 秧秧变奏入场, 直接按一次 e 切形态然后重击打出1苍, 接着开大"
        "开大后, 接 e 技能切形态, e 按下的一瞬间普攻预输入重击, 这时候秧秧会升空然后直接打出1羽"
        "然后继续长按接点按普攻打出第二个羽"
        "2羽打完之后, 有处决打处决强制取消后摇, 然后按循环宏;
         没处决就要等后摇结束才能按循环宏, 自己多打几次看看手感"
    手动段【逐帧量出来的墙钟】(第3轮, 那段视频是原速, 游戏内倒计时≈墙钟):
        b73.1 宏最后一格变奏入场
        b74.0 按 E              (入场锁 0.9s, 对上 M_INTRO_LOCK)
        b74.0~74.8 长按 -> 1苍打出, 重击就绪图标熄灭   (0.8s)
        b74.8~76.2 重击收招, 然后按 R                  (1.4s)
        b76.2~76.4 R 演出(倒计时冻住); 【HUD v140.7 就回来了, 但收招还要 0.8s】
        b76.4 按 E 切羽剑式 (v141.5, 比 HUD 回来晚 0.8s —— 见 M_R_TO_E)
        b76.4~80.7 【一路长按】普攻连段 -> 重击·羽剑式 -> 释羽风落 -> 聆风祀声  (4.3s)
        b80.9~82.9 松手【点按】, 低空湮象风华连段 = 第2羽                      (2.0s)
        b82.9 循环宏起点

    ================= 两条宏怎么读出来的 =================
    宏面板三列(按键 / 动作 / 延时ms)。动作那一列【矮的图标 = 按下, 高的 = 抬起】, 所以
    【按下那行的延时 = 按住多久, 抬起那行的延时 = 松开到下一次按下的间隔】; 末行 9999 = 结束。
    启动宏 49 对键(8 页 x 6 对 + 末尾单独放大的一对), 循环宏 45 对(7 页 x 6 对 + 3 对)。
    【转录做过对表】: 把宏表的切人时刻跟实录里读出来的出战角色时间线对齐, 开局 9 秒内的
    8 次切人全部落在 0.1 秒以内(中间穗穗只在场 0.35 秒的那一下被最短段过滤掉了, 不是错)。
    9 秒往后对不上是因为【穗穗大招演出会把游戏内倒计时冻住约 4.2 秒】, 跟转录无关。
    【剑式的奇偶也对得上】, 这是第二重验证: 秧秧默认苍剑式, 按一次 E 换一次形态。
    启动宏里她只有 1 个 E(第23格) -> 进手动段时是羽剑式 -> 手动段第一个 E 换成苍剑式,
    正好对上字幕的"重击打出1苍"; 手动段第二个 E 换回羽剑式, 对上"打出1羽"。
    循环宏里她有 2 个 E(第2、23格), 加手动段的 2 个 = 一轮 4 次, 偶数 —— 每轮回到羽剑式,
    下一轮的手动段照样是"先苍后羽"。【宏表要是抄错一个 E, 这个奇偶就崩了】。

    ================= 每一格为什么在那(改表之前先读这一节) =================
    【穗穗】两个形态, 两条【不同】的资源条:
      · 浣尘时(初始): 普攻命中回【水云息】(上限120), E(共鸣技能·浣尘时)向前突进 +40。
        水云息【满】时 E 会换成【醒春潮】—— 放出去就进濯雨时。
      · 带协奏满切进来(变奏技能·泠泠漱玉声)也直接进濯雨时, 同样消耗所有水云息。
      · 濯雨时(15 秒): 普攻·濯雨时/重击命中回【芳菲信】(上限600),
        E(共鸣技能·濯雨时)突进回 100 点。15 秒后自动退出。
      · R(康衢之谣) = 在场上铺【山河水境】30 秒, 【它不消耗芳菲信】。
      · 【芳菲信是"切走"那一下结算的】: 延奏技能·渌水盈盈 退出濯雨时、消耗所有芳菲信,
        按消耗量解锁 200/400/600 三档 —— 【600 才有第3次翾舞和烟岚】。
        所以"三段回路满"这道闸的真正位置是【切走之前】; 宏里 R 之后紧接着就切秧秧,
        卡在 R 前面是等价的。
    【千咲】核心资源是【锯环残响】(上限100), 普攻和共鸣技能命中时攒:
      · R(即刻·归无) 回 40 点残响, 并进入【万缕·汇终】15 秒 —— 锯环·疾攻/终结 +120% 倍率。
      · 残响【满】且【在地面】时, E 换成【齿轨轮回】, 放出去【进入电锯模式】。
        这就是"强化E" —— 没放出来, 后面那串长按全是普通普攻, 整轮千咲的输出作废。
      · 电锯模式里: 【长按】普攻从锯环·疾攻【第2段】起手(短按是第1段), 按住会自动接第3段;
        残响被消耗到 0 之后, 下一次按普攻 = 【锯环·终结】(清空残响, 全队护盾)。
      · 所以宏里那一串读起来是: Q -> R(开 15 秒窗口) -> E(进电锯) -> 切走让别人打
        -> 切回来 长按A 1150ms(疾攻 2->3 段) -> 短按A(锯环·终结) -> 切走。
        【1150 不是随手写的数】: 它要盖住疾攻第2段到第3段那一整段。
    【秧秧·玄翎】见上面"2羽1苍"那一节的苍翎账。

    ================= 保底的边界(2026-09-22 实机教训, 加保底之前先读这一节) =================
    【宏表本身是作者实机验证过的, 保底的职责是"别让打断把整轮废掉", 不是"纠正宏"】。
    分界线只有一条: **这个保底会不会改变游戏状态**。
      · 只花时间的 -> 安全, 可以默认开:
        切人确认(补按数字键)、等入场、等收招、大招连发(R 在 CD/演出里按是空操作)、
        纯读屏的判据(等图标灭)。最坏的后果是这一轮慢一点。
      · 会改状态的 -> 【默认关掉】, 出问题时再按需打开:
        补按 E(秧秧每按一次 E 就翻一次剑式!)、额外点普攻(耗流响/推连段/攒资源)、
        多放一次技能(吃 CD、吃资源)。这类保底一旦判据误判, 【就把本来对的流程搞坏了】,
        而且外表看不出来。
    【踩过的那次】: 给 1苍 加了"没打出来就再走一轮 E+长按"的重试, 看起来很合理 ——
    可秧秧的剑式是有奇偶性的(启动宏 1 个 E + 手动段 2 个, 一轮正好翻回原位),
    多按那一次 E 直接把形态翻掉, 于是后面那个"1羽"打出来的其实是【苍剑式重击】,
    绝息/流岚全错位。**少打一发, 远好过打错一发。**

    ================= 打断了怎么办(每一格的判据和兜底) =================
    总开关 SAFETY 关掉 = 全部退化成纯照宏打, 下面这些判据一个都不跑。
      格子                判据                          没成立怎么办
      切人                in_team() 读到目标 index      补按数字键, 最多多等 SWITCH_EXTRA;
                                                        累计 MACRO_ABORT_DESYNC 次【放弃整轮】
      穗穗 R (R3)         suisui_forte3 (芳菲信 600)    没满就接着点普攻攒, 到 FORTE3_WAIT 照放
      任何大招 (R!/R3)    HUD 消失 = 演出开始            连发到出手, 还不出再补救一轮
      千咲 E* (齿轨轮回)  E 图标白像素 >= 0.13          等不到就照按一次(落在普通E 上也是攒残响);
                                                        按完再确认图标暗下去, 没暗就重按
      千咲长按A           上一格 E* 有没有进电锯         没进就先补一发 E, 再长按
      秧秧 1苍            重击就绪图标【熄灭】           到 HEAVY_CAP 照走(压到 1.30 就是为了这个)
      秧秧 1羽            【没有可用判据】—— 聆风祀声   固定 M_YU_HOLD; M_YU_TRACE 把图标读数
                          会让图标一直亮着               打进日志, 打歪了靠它调
    【切人之后紧跟着长按的格子要额外等一下】: 见 HOLD_AFTER_SWITCH。

    ================= 宏里的 1/2/3 =================
    是【作者的队伍槽位】(从实录右侧头像栏读的: 1 穗穗 / 2 千咲 / 3 秧秧·玄翎)。
    这里【按角色翻译回槽位】(char.index + 1), 用户自己的队伍顺序不一样也能跑。

    ================= 这一版的判断都在哪 =================
    两条宏【逐格按时间回放】, 保底挂在格子里(切人确认、大招盯 HUD 补按), 关掉 SAFETY
    就是纯照宏打。手动段全程读屏: 苍翎满不满看重击就绪图标(is_mouse_forte_full),
    重击放没放看它暗没暗, 交接等协奏真满。
    【别把返回点挪进任何演出里】—— 演出期间读不到目标, 框架会判脱战、重进战斗、重跑启动轴。
    """

    # ==================== 全局节奏 ====================
    A_INTERVAL = 0.12            # 0.12 是实测的地板, 更密会让空中角色打出下落攻击
    KEY_INTERVAL = 0.10
    # 【普攻必须真的按住几十毫秒才打得出来】: task.click() 那条路按不住 ——
    # BaseWWTask.click 会把不带坐标的调用的 down_time 【无条件覆盖成 0.01】, 底层
    # genshin.do_click 又是"按下-立刻抬起-再睡 down_time"。所以这个文件里所有的"点一下"
    # 都走 tap(), 那是 mouse_down -> 等 -> mouse_up
    A_TAP = 0.06

    # ---- 切人 ----
    SWITCH_TIME_OUT = 2.5
    SWITCH_KEY_DOWN_TIME = 0.02
    SWITCH_KEY_INTERVAL = 0.0
    SWITCH_SETTLE = 0.0
    UNTRUSTED_CONFIRM = 3
    TRACE_SWITCH = True

    # ---- 大招 ----
    LIB_FIRE_WINDOW = 1.20
    LIB_KEY_INTERVAL = 0.03
    LIB_READ_EVERY = 2
    LIB_ANIM_TIME_OUT = 8.0
    LIB_ANIM_TAIL = 0.15
    HUD_NO_ANIM_GRACE = 0.35
    LIB_GONE_CONFIRM = 3         # HUD 连续这么多帧不在 = 演出真的开始了
    HUD_UP_CAP = 1.0             # 按 R 之前等 HUD 在场的上限(防 fire_lib 假成功)

    # ---- 协奏 ----
    CON_WAIT_TIME_OUT = 2.0
    CON_POLL_INTERVAL = 0.05
    CON_FULL_LEVEL = 1.0
    CON_SAMPLE_MAX = 24

    FIELD_SETTLE_TIME_OUT = 1.5
    E_RESEND_STEP = 0.06
    SKILL_BAR_SETTLE = 0.40

    # ==================== 重击就绪图标(= 秧秧的苍翎满) ====================
    # 判据跟长离那条轴用的是同一个: 回路条右边那个重击就绪指示。对秧秧来说它亮 = 苍翎满 2 点,
    # 暗 = 重击已经放出去(消耗了全部苍翎)。【先要读到过"满"才认"清空"】, 见 hold_until_forte_cleared
    FORTE_CONFIRM = 2            # 连续亮这么多帧才算(特效扫过去会闪一下)
    # 长按重击的上限。【只给 1苍 那一段用】(R 之后那段走 hold_yu_blind, 不读图标)。
    # 【从 2.50 压到 1.30】: 实测 1苍 只要 0.8s(b74.0 按住 -> b74.8 图标熄灭), 给到 2.5
    # 是在赌判据一定成立。万一哪轮剑式漂了、这一格打出来的是羽剑式重击, 图标就会因为
    # 聆风祀声继续亮着(见 M_YU_HOLD 上面那段), "等它灭"当场失效、白按满上限 ——
    # 干跑里复现过(L31苍重击(CAP,repress2,2.53s))。压到 1.30 的话这种情况只亏 0.5 秒
    HEAVY_CAP = 1.30
    # 【0.90 -> 0 (关掉)】。2026-09-22 实机数据: 12 轮 1苍 里
    #   repress0 -> cleared (0.52s / 0.78s)      <- 成功的两轮
    #   repress1 -> CAP     (1.30~1.33s)         <- 失败的十轮
    # 这一段是从长离那条轴逐字抄来的: 她的焚身以火是"按住到条件满足", 中途松开再按
    # 只是补一个按下沿, 没坏处。**但秧秧的重击要连续按住才派生** —— 0.9 秒那一下松手
    # 直接把蓄力打断, 重新计时又撞上 HEAVY_CAP, 于是必然 CAP。1羽 那边同理
    # (L41羽出手(CAP,2.01s))。
    # 这正是"长按期间绝对不要再 mouse_down"那条的变体: 松开重按比单纯补按更狠
    HEAVY_REPRESS = 0.0          # 0 = 不重按, 一路按到底
    HEAVY_SEE_GRACE = 0.50       # 这么久一次都没读到亮 -> 判据读不到, 改盲按
    HEAVY_BLIND_HOLD = 0.90

    # ==================== 防重入 ====================
    OPENER_MIN_GAP = 60.0

    # ==================== 手动段(2羽1苍) ====================
    # 宏最后一格是变奏切秧秧, 返回时【入场动作还在演】。这段按键会被游戏吃掉,
    # 所以第一个 E 要等它演完。框架的 intro_motion_freeze_duration 是 0.9,
    # 实录里羽挟苍空的攻击动作到能接 E 大约 0.85s。
    # 【0.85 是卡在锁边上的】: 干跑(它没有预输入, 锁期间的键直接丢)里这一下 E 经常被吞,
    # 靠 ensure_forte_ready 的补按救回来。真机有预输入, 锁里按的键会在能出招的第一帧触发,
    # 所以这里不往上加 —— 字幕就是"直接按一次 e"。实机要是日志里天天出现"E 多半被吃了",
    # 再往 0.95 抬
    M_INTRO_LOCK = 0.85
    # 【E 一次只能发一下】: 剑式切换每按一次换一个形态, 连发两下等于换回去了。
    # 所以补按由"看图标还不亮"驱动, 不是拿窗口连发盖 —— 见 send_e_once / ensure_forte_ready
    M_USE_FORTE_ICON = True      # 关掉 = 不读重击就绪图标, E 发一下就按固定节奏往下走
    M_FORTE_CAP = 0.80           # 发完 E 等图标亮的上限(秒)
    # 到点没亮再补几次 E。【补按不是白补的】: 要是那一下 E 其实放出去了、只是图标没读到,
    # 补的这一下就把形态又换回去了(而且流响是满的, 换回去的那次是"剑式切换", 不给苍翎)。
    # 所以这个数别往上加; 判据要是实机不靠谱, 是关 M_USE_FORTE_ICON 而不是多补几次
    # 【默认 0 = 不补按】。同上: 补按 E 会翻剑式。而且这个判据(mouse_forte)读的是
    # "苍翎 >= 1"而不是"满 2", 本来就分不出"E 到底生效没有" —— 拿它驱动补按等于瞎猜
    M_E_RETRIES = 0
    # E 之后到按住普攻的间隔。重击从 E 派生, 太早按会被 E 的动作吃掉
    M_E_TO_HEAVY = 0.10
    # 【1苍 没打出来就再来一轮】(2026-09-22 实机: 8 轮里 7 轮 CAP, 重击根本没出手)。
    # 根因: 手动段那一下 E 是【剑式切换】而不是【剑式流转】。只有【流响耗尽】时按下去的
    # 才是流转(回 100 流响 + 1 点苍翎), 没耗尽时按的只换形态、不给苍翎 —— 苍翎停在
    # 变奏入场给的那 1 点, 而重击要满 2 点。
    # 【重击就绪图标区分不了这两种】: 实测 苍翎满(0.04s) 是在按 E 之前就亮着的,
    # 说明它代表的是"苍翎 >= 1"而不是"满 2", 所以判据只能告诉你【重击有没有出手】,
    # 告诉不了你【为什么没出手】。
    # 补救之所以成立: 【第一轮那 1.3 秒长按打的普攻本身就在耗流响】—— 所以第二次按 E
    # 很可能正好落在"流响耗尽"上, 变成剑式流转, 苍翎补到 2 点, 第二次长按就打得出来了。
    # 代价是失败那轮多花约 1.5 秒
    # 【默认 0 = 不重试】。重试会多按一次 E, 而秧秧【每按一次 E 就翻一次剑式】——
    # 一轮的剑式奇偶(启动宏 1 个 E + 手动段 2 个)被打乱之后, 后面那个"1羽"打出来的
    # 是苍剑式重击, 绝息/流岚全错位, 比"1苍 少打一发"坏得多。
    # 真要开, 先确认判据能区分"苍翎满2"和"苍翎>=1" —— 现在的 mouse_forte 区分不了
    M_CANG_RETRIES = 0
    # 1苍(重击·苍剑式)打完到按 R 的间隔。
    # 【0.25 -> 0.85, 用户 2026-09-22 实机: "秧秧的R开的太快了, 把前面那个重击伤害给吞了"】。
    # 原来按"早按没坏处, fire_r 会重试"写的 —— 那个想法只对"按键被游戏拒绝"成立,
    # 这里是【R 真的放出去了, 但把还没结算完的重击打断了】, 重试兜不住, 伤害直接没了。
    # 实录里这个间隔是 1.4s(b74.8 图标熄灭 -> b76.2 大招出手); 先按用户说的加 0.6 试,
    # 还吞就继续往 1.4 加
    M_CANG_TO_R = 0.85
    M_R_WINDOW = 2.00            # 传给 fire_lib 的窗口
    # 【R 演出结束到按 E 的间隔 —— 这一格丢了整个 R 之后就全错】(2026-09-22 实机)。
    # fire_r + wait_hud_back 等的是【过场演出】(HUD 消失再回来), 返回那一刻演出确实结束了,
    # 但【收招动作还在演】, E 按在这段里会被游戏整个吃掉。E 又不像 R 那样会重试,
    # 被吞就是彻底丢 —— 剑式没切成羽, 后面那一路长按打出来的是苍剑式的普攻, 全歪。
    # 0.80 有两处独立来源对上: ① 这个文件的判据驱动旧版里实机标定的 LIB_TO_E = 0.8;
    # ② 实录逐帧 —— HUD 在 v140.7 就回来了, E 是 v141.5 才按的, 正好 0.8 秒
    M_R_TO_E = 0.80
    # 【等落地再按 E】。也是从判据驱动旧版搬过来的(它叫 WAIT_DOWN_BEFORE_E):
    # 大招收尾人可能还在空中, 空中按 E 跟地面不是一回事, 而且重击·羽剑式的条件里
    # 明写着"并且处于地面时"。wait_down() 期间会点普攻 —— 【这是想要的】:
    # 普攻消耗【流响】, 只有流响耗尽时按下去的那一次 E 才是"剑式流转"(回 100 流响
    # + 1 点苍翎), 没耗尽的话按出来的是"剑式切换", 只换形态不给苍翎, 苍翎就凑不够 2 点
    M_WAIT_DOWN_BEFORE_E = True
    # 按 E 的按下时长(秒)。【别用框架默认的 0.01】: 旧版注释写着"收招那一下可能吃不到",
    # 它自己用的是 E_KEY_DOWN = 0.05
    M_E_KEY_DOWN = 0.05
    # 大招演完之后的第二个 E 到按住左键的间隔。字幕说【e 按下的一瞬间普攻预输入重击】,
    # 所以这个数要小; 反过来先按住左键会先打出一段普攻, 把形态切换的派生窗口顶掉
    M_E2_TO_HEAVY = 0.05
    # ================= R 之后这一段【不能用重击就绪图标当判据】 =================
    # 【这是 2026-09-22 第一次实机栽的地方】(用户: "秧秧R之后的操作完全不对")。
    # 原来这里跟 1苍 一样调 hold_until_forte_cleared(按到图标熄灭), 可羽剑式这一路
    # 打完重击【图标根本不会灭】: 重击·羽剑式 -> 释羽风落 -> 进【聆风祀声】12 秒,
    # 羽剑式普攻被替换成普攻·湮象风华, 左键图标【继续保持高亮】, 只是里面的图案换了。
    # 而框架的 find_mouse_forte() 是把图标二值化之后匹配 'mouse_forte' 模板
    # (threshold 0.6), 认的是外圈那个亮环, 【分不出里面的图案】—— 于是"等它灭"
    # 永远不成立, 一路按满 HEAVY_CAP 再走, 后面整段节奏跟着歪。
    # 逐帧量出来的(第3轮, 这段视频是原速, 战斗时间≈墙钟):
    #   b76.4 按 E -> b76.4~80.7 一路长按(普攻连段 -> 重击·羽剑式 -> 释羽风落 -> 聆风祀声)
    #   -> b80.9~82.9 松手点按, 低空湮象风华连段 -> b82.9 循环宏起点
    # 对照 1苍 那段: b74.0 按 E -> b74.8 图标熄灭, 【那一段判据是好的】, 所以只改这里。
    M_YU_HOLD = 4.30             # E 之后一路按住的【总】时间(秒)。实测 b76.4->80.7
    # 【判据其实是有效的 —— 2026-09-22 实机 trace 推翻了之前看视频得出的结论】。
    # 原先以为"聆风祀声会让图标一直亮着, 这一段没判据可用", 那是看视频截图得出的:
    # 画面上那个粉环确实一直亮。但【框架认的不是粉环, 是 mouse_forte 这张图】——
    # 湮象风华换了图案, 模板就匹配不上, 实测 trace:
    #   L11羽: 0.02:1 0.33:1 0.65:1 0.97:0 1.29:0 ... 4.13:0   <- 0.97s 就灭了
    # 所以现在两件事都做: 判据负责【确认重击真的出手了】, 按满时间负责
    # 【让释羽风落/聆风祀声那几段接上】。等待判据的时间算在 M_YU_HOLD 里面
    M_YU_HEAVY_CAP = 2.00        # 等重击打出去的上限(秒), 实测 0.97
    M_YU2_TAPS = 4               # 松手之后点几下(低空湮象风华连段)
    M_YU2_INTERVAL = 0.45        # 点按的间隔(秒)。4 x 0.45 = 1.8s, 实测那段 2.0s
    # 【最后一下点按之后还要等它打完再按处决】(2026-09-22 用户: "秧秧的处决快了,
    # 第二个羽没打完就开了")。点按只是"发出去", 那一段湮象风华还要演;
    # 处决带全局时停, 抢在里面按就把没结算完的那一段掐了 —— 跟 1苍 抢 R 是同一个毛病。
    # 实录里第2羽打到 b82.9 才接循环宏, 而 4 x 0.45 = 1.8s 只到 b82.7
    M_YU2_TAIL = 0.45
    # 【没处决的时候要自己等后摇演完再接循环宏】。字幕原话:
    #   "2羽打完之后, 有处决打处决强制取消后摇, 然后按循环宏;
    #    没处决就要等后摇结束才能按循环宏, 自己多打几次看看手感"
    # 处决的作用就是【取消后摇】—— 没打成的话后摇还在, 这时候直接进循环宏,
    # 循环宏第一格的 W/E 会被后摇吞掉, 一路错下去
    M_YU2_NO_BREAK_TAIL = 0.60
    # 长按期间每隔一会儿读一次重击就绪图标, 【只打日志不打断】。留着是因为这一段
    # 现在完全靠固定时长, 实机要是打歪了, trace 是唯一能看出"图标什么时候变的"的东西
    M_YU_TRACE = True
    M_YU_TRACE_EVERY = 0.30

    # ==================== 保底 ====================
    # 总开关。关掉 = 两条宏纯照表回放(切人不确认、大招不补按), 跟人按宏一模一样
    SAFETY = True
    # 【切人一格错, 后面每一格都发在错的人身上】—— 这是整条轴最该有的一道保底。
    # 剩下的 gap 照等, 时序一点不变; 被游戏拒绝(上一个动作/入场动画没演完)就一直补按,
    # 最多再等 SWITCH_EXTRA(游戏的换人 CD 约 1 秒)
    SWITCH_EXTRA = 1.50
    SWITCH_REPRESS = 0.05        # 没到场时补按数字键的间隔
    # 连续读到目标 index 这么多帧才算到场(特效会盖住槽位)。
    # 【这道确认是有代价的】: 宏表给切人格的 gap 多数只有 50ms, 而"按下 -> 游戏换人 -> 连读
    # 两帧确认"比这长, 所以每个切人格都会晚一点。干跑量到的是【每格晚 0.13s, 一轮 16 个切人格
    # 累计 1.7s】(启动宏 24.96s vs 表 23.29s, 循环宏 23.27s vs 表 21.48s)。
    # 一轮 28 秒里多出来的 1.7 秒会挤占绝息/流岚那两个 25 秒 CD 的 buff 窗口, 实机要盯。
    # 嫌慢有三条路, 按代价从小到大: 压成 1(特效误判的概率上去一点) / MACRO_SPEED 调到
    # 0.93 左右把整条表按比例缩回去 / 直接关 SAFETY 纯照宏打
    SWITCH_CONFIRM = 2
    # 【切人没确认就别假装切过去了】: 累计这么多次就放弃这一轮宏交回框架 ——
    # 乱着打完一整轮不如早点重来
    MACRO_ABORT_DESYNC = 2
    E_CD_CAP = 1.60              # 'E#'(按到进 CD)那类格子的上限
    # 'E#' 的"先见亮才认暗"那道门等多久。【默认的 0.15 太短】: 切人后技能栏要过几帧
    # 才换成新角色, 那几帧读到的是【上一个人】的 CD —— 0.15 秒内没见过"可用"就会被
    # 当成"本来就在 CD 上"直接跳过, E 一次都不发。而穗穗的 E 恰好紧跟在切人后 100ms。
    # 干跑里复现过: SuE_没见过亮(x5,0.45s)
    E_READY_GRACE = 0.40
    E_SPAM_INTERVAL = 0.06
    R_EXTRA_CAP = 2.00           # 大招没出手时补救的上限

    # ---- 切人之后紧跟着的长按, 要多等一下 ----
    # 【用户 2026-09-22 实机: "切千咲的时候会愣一下再打"】。
    # macro_switch 确认的是"in_team() 读到目标 index"= 人已经在场了, 但【在场 != 能出招】:
    # 入场动作还要演几百毫秒。宏表里切人格的 gap 只有 50ms, 紧跟着的 1150ms 长按,
    # 【按下沿正好落在入场动作里被丢掉】 —— 而长按又不能补按(PostMessage 重发会把
    # 已经按住的状态打断, 见 tap/A_TAP 那段), 所以只能等游戏先把入场演完再按下去。
    # 对千咲尤其要命: 锯环·疾攻【长按才从第2段起手】, 按下沿丢了就退化成第1段。
    # 只对"上一格是切人 + 这一格按住时间 >= HOLD_SETTLE_MIN"的格子生效, 短按不受影响
    HOLD_AFTER_SWITCH = 0.20     # 等多久(秒)
    HOLD_SETTLE_MIN = 0.30       # 按住多久才算"长按", 短于这个的不等

    # ---- 千咲: 大招之后那发强化E ----
    # 【用户 2026-09-22 实机: "千咲的流程也不对, 没放出强化E"】。两个原因叠在一起:
    #  ① 宏表里千咲 R 那格后面紧跟着 E(gap=0), 而大招演出刚结束时【收招还在演】,
    #     E 按在这段里被整个吃掉 —— 跟秧秧的 M_R_TO_E 是同一个坑;
    #  ② 强化E 要【回路能量满】才放得出来, 满没满是打出来的, 表给不了保证。
    # 判据用 E 图标的白像素占比, 阈值是判据驱动旧版标定的: 亮起前基线 0.0000,
    # 亮起后持续在 0.158~0.211, 噪声见过 0.0942 —— 所以 0.13 卡在噪声和信号中间。
    # 【到点没亮也照按一次】: 按了不亏, 落在普通E 上也是在攒回路
    CHI_E_STAR = True
    # 【0.60 -> 0.15】(2026-09-22 实机, 用户: "为什么每次千咲放强化E都要卡一下才放")。
    # 实录里 R 演完之后 E 图标【0.12 秒就读到亮了】—— 残响早就满了, 那 0.6 秒纯粹是干站着。
    # 而且 0.6 还不保险: 18:23 那轮按下去照样被吞("强化E 按了但图标一直亮着")。
    # 【改成连发盖住收招】之后这个数就不需要大了, 留一点只是别在 HUD 刚回来那一帧就发
    # 【0.35 -> 0.20】(2026-09-22 用户第三次提: "正常流程千咲都是R完后按强化E,
    # 实机跑下来感觉还是不流畅")。实测 R 演出结束到按下 E 的间隔是 0.49~0.67 秒,
    # 拆开= 这个等待 + fill_saw_resonance 读一次屏(0.05) + cast_enhanced_e 又读一遍(0.12)。
    # 后面那一遍已经去掉了(见 'E*' 分支), 这里再压一点。
    # 【别压到 0】: R 演出结束(HUD 回来)之后收招还在演, 发出去的键会被丢掉 ——
    # 而这一下是单发, 丢了这一轮就没电锯了。日志里 `强化E(没亮` 变多就往上加
    CHI_R_TO_E = 0.20
    # 连发窗口: 发一次 -> 读图标 -> 没暗就再发。收招期间发的会被游戏丢掉, 单发必丢,
    # 只有连发盖得住(跟 fire_r 是同一个道理)
    # 【连发窗口默认 0 = 只发一次】。连发能盖住收招, 但齿轨轮回一放出去 E 就换回
    # 解弦之眼(有 CD), 多按的那几下会真的放出去、吃掉残响 —— 又是"改状态"那一类。
    # 收招靠 CHI_R_TO_E 等过去就够了; 真被吞了这一轮少一次电锯, 下一轮照常
    CHI_E_FIRE_WINDOW = 0.0
    CHI_E_FIRE_INTERVAL = 0.10
    CHI_E_LIT_BOX = 'box_resonance'
    CHI_E_LIT_COLOR = {'r': (200, 255), 'g': (200, 255), 'b': (200, 255)}
    CHI_E_LIT_THRESHOLD = 0.13
    CHI_E_LIT_CONFIRM = 2        # 连续这么多次过阈值才认, 挡单点噪声
    CHI_E_LIT_POLL = 0.03
    CHI_E_LIT_MAX_WAIT = 1.20    # 等图标亮的上限(秒)
    # 按完之后回头确认: 齿轨轮回放出去了, 强化态就被消耗掉, 图标应该暗下去。
    # 【还亮着 = 那一下被吞了】(入场锁/收招/硬直), 重按一次。
    # 【别用 has_cd 判】: 强化段很可能只消耗强化态、不进基础冷却 —— 旧版注释里写着
    # 秧秧那边实测 7/7 都判错就是这个原因
    CHI_E_CONFIRM = True         # 关掉 = 发一次就走, 不读图标确认
    # 【长按锯环·疾攻之前, 确认人真的在电锯模式里】。E*(齿轨轮回)要是被吞了, 这一下
    # 1150ms 长按打出来的是【普通普攻】, 整轮千咲的输出作废, 而且外表看不出区别 ——
    # 所以宁可在这里多花一点时间补一发 E
    # 【默认关】: 补那一发 E 同样是"改状态"(多吃一次 CD/残响)。
    # 没进电锯这一轮千咲输出就少, 但不会把别的东西带歪
    CHI_SAW_GATE = False
    # ---- 残响不够就先点普攻攒够再开强化E ----
    # 【用户 2026-09-22 实机要求】: "实战情况多样, 千咲在本该开强化E的时候回路能量不够,
    # 开不了强化E, 需要多A几下打够能量开强化E"。
    # 【这一条属于"改状态"里的例外】: 多点几下普攻攒的就是【锯环残响】—— 那正是这一格
    # 需要的资源, 不像补按 E 那样会翻形态/吃CD。跟穗穗的回路闸是同一类。
    # 判据还是 E 图标的白像素占比(亮 = 残响满, 齿轨轮回就绪)
    CHI_FILL_SAW = 2.50          # 点普攻攒残响的上限(秒), 0 = 关掉
    CHI_FILL_INTERVAL = 0.12
    # 【补救那一发等得短一些】: E* 那一格已经等过 CHI_E_LIT_MAX_WAIT(1.2s) 都没亮,
    # 说明多半是【残响真的没攒满】而不是那一下被吞了 —— 补按救不回来, 等满一样白等。
    # 给 0.4s: 够覆盖"被吞"那种(图标本来就亮着, 一读就中), 不够的那种也不拖太久
    CHI_SAW_RETRY_WAIT = 0.40

    # ---- 大招前的能量闸(所有 R!/R3 那类格子共用) ----
    # 【用户 2026-09-22 实机: "每次千咲的R能量都不够, 肯定是前面少打了什么"】。
    # 把两条宏里千咲到自己 R 为止的动作拉出来对比, 差别是实打实的:
    #   启动宏: E + A x7   (1.95 / 3.55 / 3.80 / 4.10 / 4.50长按 / 7.50 / 8.25空中A)
    #   循环宏: E + A x5   (2.20 / 3.65 / 5.56 / 5.81 / 6.11)
    # 循环轮本来就少两下, 而且那 5 下【全都紧跟在切人后】(切人格 gap 只有 50ms),
    # 入场动画还要再吞掉一部分 —— 所以启动轴的 R 放得出来, 循环轴放不出来。
    # 实机日志: ChR补救_NOFIRE(x40/x41) 出现 5 次 —— 连按 40 下都放不出来, 就是能量没满。
    # 【大招是能量门控不是 CD 门控】: 判据用 liberation_available()(读图标亮不亮),
    # 不是 has_cd。能量靠普攻/技能命中攒, 【干等等不来, 必须动手点】——
    # 跟穗穗的回路闸、千咲的攒残响是同一类"攒的正是这一格要用的资源", 安全
    LIB_FILL = 2.50              # 图标不亮时点普攻攒能量的上限(秒), 0 = 关掉
    LIB_FILL_INTERVAL = 0.12

    # ---- 穗穗大招前的回路闸 ----
    # 【用户 2026-09-22 实机报的】: "穗穗在启动轴里没有打满回路就开R了"。
    # 宏是照表按时间走的, 表里给穗穗攒回路的那几下 A 够不够, 取决于打没打中、有没有被
    # 怪打断 —— 宏本身给不了任何保证。满不满读 suisui_forte3 这张图(芳菲信 600 那一档),
    # 阈值和确认帧数都是从判据驱动旧版搬过来的(它那边叫 FORTE3_THRESHOLD/FORTE3_CONFIRM)。
    # 【等的时候必须点普攻】: 回路就是普攻攒出来的, 干等永远等不满。
    # 【这一格会把后面整条宏往后推】—— 等多久推多久, 跟切人确认是一个性质
    FORTE3_GATE = True
    FORTE3_WAIT = 3.0            # 等的上限(秒), 超了照放不误: 少一档好过把整轮宏卡死
    FORTE3_THRESHOLD = 0.75      # 旧版标定的值, 注释写着"原来 0.6 太松会误判"
    FORTE3_CONFIRM = 2           # 连读这么多帧都命中才认, 单帧误判不算
    # 一下普攻都没点就读到"满", 而且快于这个秒数 -> 打一条警告(只报不拦)。
    # 见 wait_forte3 里那段: 这种读数多半是穗穗没进濯雨时、读到水云息条了
    FORTE3_SUSPECT = 0.30

    # 处决。字幕: "2羽打完之后, 有处决打处决强制取消后摇, 然后按循环宏"。
    # 【只在手动段末尾按这一次】—— 处决带全局时停、动画期间 HUD 整个不在,
    # 按在别处会骗过大招/重击的 HUD 判据
    F_BREAK = True
    F_BREAK_ANIM = 5.00          # 按完等 HUD 回来的上限(处决动画时长因角色而异)

    MACRO_SPEED = 1.00           # 整条宏的速度系数, 1.0 = 照表

    # ==================== 两条宏(逐条从宏面板截图抄下来的) ====================
    # 每行 = (动作, 按住ms, 松开后等ms, 注释)。动作:
    #   'A'      左键(普攻)。按住 ms 就是宏里那个按住时长, 1150/650/600 那几格是长按
    #   'W'      向前走一下(循环宏第一格, 调位置用)
    #   'E'/'R'/'Q'   共鸣技能 / 共鸣解放 / 声骸技能, 【发给当时在场的那个人】
    #   'R!'     大招: 【连发到 HUD 消失为止】, 再等演出结束。不是"发一次然后盯着",
    #            原因见 macro_key 里那段注释(宏表里 Q 那格的 gap 是 0)
    #   'R3'     穗穗大招: 先等三段回路满(没满就接着点普攻), 再走 'R!' 那一套
    #   'E*'     千咲的强化E(齿轨轮回): 先等大招收招演完, 再等 E 图标亮, 按完确认进了电锯
    #   'A~'     千咲的电锯长按(锯环·疾攻 第2段起手 -> 自动接第3段): 长按前先确认在电锯模式,
    #            不在就补一发 E。其余跟 'A' 一样(含切人后的入场等待)
    #   'SPACE'  跳(走框架配置的跳跃键)
    #   '>SUI'/'>CHI'/'>YY'  切人; 结尾带 '^' = 这一下是变奏入场(协奏满), 【只影响框架记账】
    # 末行的 9999 在表里写成 0: 那是宏自己的结束标志, 不是真要等 10 秒
    OPENER_MACRO = (
        # 开局场上就是穗穗(1 号位), 字幕: "流程从穗穗3a到秧秧最后的变奏入场结束"
        ('A',      50,  250, '穗A1'),
        ('A',      50,  600, '穗A2'),
        ('A',      50,  200, '穗A3'),
        ('>YY',    50,  150, '切秧秧'),
        ('A',      50,  100, '秧A'),
        ('>CHI',   50,   50, '切千咲'),
        ('E',      50,  250, '千E'),
        ('A',      50,  250, '千A'),
        ('>SUI',   50,   50, '切穗穗'),
        ('E#',     50,  200, '穗E(按到进CD —— 切人后 100ms 就按, 会被入场动画吞)'),
        ('>YY',    50,   50, '切秧秧'),
        ('A',      50,  400, '秧A'),
        ('A',     100,  200, '秧A'),
        ('>CHI',   50,   50, '切千咲'),
        ('A',      50,  200, '千A'),
        ('A',      50,  250, '千A'),
        ('A',      50,  350, '千A'),
        ('A',     100,  450, '千A'),
        ('>SUI',   50,  600, '切穗穗'),
        ('A',      50,  800, '穗A'),
        ('A',      50,  250, '穗A'),
        ('>YY',    50,   50, '切秧秧'),
        ('E',      50,  250, '秧E(剑式切换)'),
        ('>CHI',   50,  200, '切千咲'),
        ('A',      50,  550, '千A'),
        ('SPACE',  50,  100, '跳'),
        ('A',      50,   10, '空中A'),
        ('>SUI',   50,   50, '切穗穗'),
        ('A',      50,  850, '穗A'),
        ('Q',      25,    0, '穗声骸'),
        ('R3',     50, 4350, '穗大招(先等三段回路满, 再连发到出手)'),
        ('>YY',    50,  800, '切秧秧'),
        ('A',      50,  250, '秧A'),
        ('A',      50,  200, '秧A'),
        ('>CHI',   50,    0, '切千咲'),
        ('Q',      50,    0, '千声骸'),
        ('R!',     50, 3700, '千大招(连发到出手)'),
        ('E*',     50,    0, '千强化E(等收招 + 等图标亮再按, 见 CHI_*)'),
        ('>YY',    50,   50, '切秧秧'),
        ('A',      50,  400, '秧A'),
        ('A',      50,  450, '秧A'),
        ('>CHI',   50,   50, '切千咲'),
        ('A~',   1150,   50, '千电锯长按A(锯环·疾攻2->3段)'),
        ('A',      50,    0, '千A(锯环·终结)'),
        ('>YY',    50,   50, '切秧秧'),
        ('A',     600,  650, '秧长按A'),
        ('>CHI',   50,   50, '切千咲'),
        ('A',      50,  300, '千A'),
        ('>YY^',   50,    0, '变奏切秧秧(宏结束, 表里 9999)'),
    )

    # 跟启动宏的差: 开头三格是秧秧自己的收尾(W/E/A, 启动宏那边是穗穗 3A), 中段的穿插顺序
    # 不一样; 从穗穗 Q 那一格往后【逐格相同】, 只差穗穗那下 A 的间隔(650 / 850)和
    # 收尾千咲那下 A 的间隔(400 / 300)
    LOOP_MACRO = (
        # 开头这三格还在秧秧身上: 手动段(2羽)刚打完, 人还是她
